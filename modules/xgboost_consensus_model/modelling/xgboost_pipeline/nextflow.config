// Reuses the main pipeline's organism_* reference defaults, conda/executor/
// process settings unchanged -- only params.samples is added below.
// xgb_model / xgb_cutoff are defined in the root nextflow.config (the main
// pipeline shares modules/xgboost_consensus_model with this one); override
// them on the command line or in a -c file.
// Four levels up from modules/xgboost_consensus_model/modelling/xgboost_pipeline/.
includeConfig '../../../../nextflow.config'

params {
    // Per-sample directories of pre-computed CNV caller output files to
    // score with the tuned XGBoost consensus model (no freec/cnMOPS). This
    // pipeline does NOT run the callers itself -- point sv_dir at wherever
    // that sample's caller TSV/VCF files already are (matched by
    // CALLER_FILE_PATTERNS in modules/xgboost_consensus_model/cnv_consensus_model.py).
    //
    // sv_dir defaults to ${projectDir}/sv_dir/<sample_name>/ when omitted.
    // Example:
    //   samples = [
    //       'my_sample': [sample_name: 'my_sample', sv_dir: '/path/to/callers/my_sample/'],
    //   ]
    //
    // Real-sample test runs: put actual sample names/paths in a separate,
    // gitignored -c override file (e.g. test_prague.config) instead of
    // here -- this file is tracked in git and must stay free of any real
    // patient identifiers.
    samples = [:]
}
