{
  "workflow_description": {
    "name":"germ_cnv_sv_calling",
    "version": 1.0,
    "label":"Germline CNV and structural variant calling",
    "type":"var_call",
    "management_system": "nextflow",
    "entry_point": false,
    "run_parameters": {
      "cpu": 31,
      "memory": 65
    },

    "inputs":[
      "mapped/{sample}.bam*"
    ],
    "outputs":[
      "structural_varcalls/*"
    ],
    "inputs_optional":[
      "cohort_data/cohort_cnv_info.tar.gz"
    ],
    "outputs_optional":[
      "cohort_data/cohort_cnv_info.tar.gz"
    ]
  },
  "general_params": [
    "entity_name",
    "sample_name"
  ],
  "requested_params": [
    "organism",
    "assembly",
    "release",
    "lib_ROI"
  ],
  "gui_params" : {
    "primary": {
      "call_cnvs": {
        "label": "Call copy number variants.",
        "type": "bool",
        "default": true
      },
      "call_SVs": {
        "label": "Call structural variants using discordant reads.",
        "type": "bool",
        "default": true
      },
      "calling_type": {
        "label": "Calling type",
        "type": "enum",
        "default": "germline",
        "list": {
          "germline": "Germline"
        }
      },
      "tumor_normal": {
        "label": "Samples are tumor-normal pairs",
        "type": "bool",
        "default": false
      },
      "panel_of_normals": {
        "label": "Provide control samples (panel of normals)",
        "type": "bool",
        "default": false
      }
    },
    "detailed": {
      "wgs_bin_size": {
        "label": "Bin size to split genome to in WGS",
        "type": "int",
        "default": 50000
      },
      "use_gatk_cnv": {
        "label": "Use GATK_cnv for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_cnvkit": {
        "label": "Use CNVkit for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_jabCoNtool": {
        "label": "Use jabCoNtool for variant calling.",
        "type": "bool",
        "default": true
      },
      "jabCoNtool_use_snps": {
        "label": "Use snps allelic frequency.",
        "type": "bool",
        "default": true
      },
      "jabCoNtool_predict_TL": {
        "label": "Predict tumor DNA fraction in somatic samples.",
        "type": "bool",
        "default": false
      },
      "jabCoNtool_normalize_to_GC": {
        "label": "Normalize read count to GC content for WGS.",
        "type": "bool",
        "default": false
      },
      "jabCoNtool_remove_centromeres": {
        "label": "Remove centromere regions in WGS.",
        "type": "bool",
        "default": false
      },
      "max_CNV_occurance_in_cohort": {
        "label": "Maximal occurance of CNV in cohort for it not to be filtered. As ratio of cohort size in percent.",
        "type": "int",
        "default": 100
      },
      "use_control_freec": {
        "label": "Use Control-FREEC for variant calling.",
        "type": "bool",
        "default": true
      },
      "AF_threshold": {
        "label": "Allelic frequency threshold for CNV calling.",
        "type": "string",
        "default": "0.5"
      },
      "purple_diploid_regions": {
        "label": "Use purple diploid regions for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_delly": {
        "label": "Use Delly2 for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_cohort_data": {
        "label": "Load coverage data from previous experiments for normal estimation. Need file: cohort_data/cohort_cnv_info.tar.gz",
        "type": "bool",
        "default": false
      },
      "create_cohort_data": {
        "label": "Save info about coverage data to the cohort_cnv_info file. (include loaded cohort data)",
        "type": "bool",
        "default": true
      }
    },
    "samples": {
      "donor": {
        "label": "Patient ID",
        "type": "string",
        "default": ""
      },
      "sample_type": {
        "label": "Sample type (role)",
        "type": "enum",
        "default": "sample",
        "list": {
          "sample": "Sample (study subject)",
          "control": "Control (reference panel)"
        }
      }
    }
  }
}

