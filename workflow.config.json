{
  "workflow_description": {
    "name":"germ_cnv_sv_calling",
    "version": 1.0,
    "label":"Germline CNV and structural variant calling",
    "type":"var_call",
    "management_system": "nextflow",
    "entry_point": false,
    "run_parameters": {
      "cpu": 31,
      "memory": 65
    },

    "inputs":[
      "mapped/{sample}.bam*"
    ],
    "outputs":[
      "structural_varcalls/*"
    ],
    "inputs_optional":[
      "cohort_data/cohort_cnv_info.tar.gz"
    ],
    "outputs_optional":[
      "cohort_data/cohort_cnv_info.tar.gz"
    ]
  },
  "general_params": [
    "entity_name",
    "sample_name"
  ],
  "requested_params": [
    "organism",
    "assembly",
    "release",
    "lib_ROI"
  ],
  "gui_params" : {
    "primary": {
      "min_number_callers": {
        "label": "Minimum number of callers to consider a variant.",
        "type": "int",
        "default": 2
      },
      "use_cnmops": {
        "label": "Use cnMOPS for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_cnvkit": {
        "label": "Use CNVkit for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_conifer": {
        "label": "Use conifer for variant calling.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": true,
            "values": {
              "lib_ROI": "wgs"
            }
          }
        }
      },
      "use_control_freec": {
        "label": "Use Control-FREEC for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_ecole": {
        "label": "Use ECOLE for variant calling.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": true,
            "values": {
              "lib_ROI": "wgs"
            }
          }
        }
      },
      "use_exomedepth": {
        "label": "Use ExomeDepth for variant calling.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": true,
            "values": {
              "lib_ROI": "wgs"
            }
          }
        }
      },
      "use_gatk": {
        "label": "Use GATK_cnv for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_jabcontool": {
        "label": "Use jabCoNtool for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_panelcnmops": {
        "label": "Use panel cnMOPS for variant calling.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": true,
            "values": {
              "lib_ROI": "wgs"
            }
          }
        }
      },
      "use_xhmm": {
        "label": "Use XHMM for variant calling.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": true,
            "values": {
              "lib_ROI": "wgs"
            }
          }
        }
      },
      "panel_of_normals": {
        "label": "Provide control samples (panel of normals)",
        "type": "bool",
        "default": false
      }
    },
    "detailed": {
      "wgs_bin_size": {
        "label": "Bin size to split genome to in WGS",
        "type": "int",
        "default": 50000
      },
      "conifer_min_rpkm": {
        "label": "Minimum RPKM to consider a probe in conifer.",
        "type": "int",
        "default": 1,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_conifer": true
            }
          }
        }
      },
      "conifer_svd_components": {
        "label": "Number of SVD components to use in conifer.",
        "type": "int",
        "default": 12,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_conifer": true
            }
          }
        }
      },
      "jabCoNtool_use_snps": {
        "label": "Use snps allelic frequency.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_predict_TL": {
        "label": "Predict tumor DNA fraction in somatic samples.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_normalize_to_GC": {
        "label": "Normalize read count to GC content for WGS.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_remove_centromeres": {
        "label": "Remove centromere regions in WGS.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_max_CNV_occurance_in_cohort": {
        "label": "Maximal occurance of CNV in cohort for it not to be filtered. As ratio of cohort size in percent.",
        "type": "int",
        "default": 100,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "purple_diploid_regions": {
        "label": "Use purple diploid regions for variant calling.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_purple": true
            }
          }
        }
      },
      "xhmm_min_target_size": {
        "label": "Minimum target size to consider in XHMM.",
        "type": "int",
        "default": 10,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_target_size": {
        "label": "Maximum target size to consider in XHMM.",
        "type": "int",
        "default": 10000,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_min_mean_target_rd": {
        "label": "Minimum mean target read depth to consider in XHMM.",
        "type": "int",
        "default": 10,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_mean_target_rd": {
        "label": "Maximum mean target read depth to consider in XHMM.",
        "type": "int",
        "default": 500,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_min_mean_sample_rd": {
        "label": "Minimum mean sample read depth to consider in XHMM.",
        "type": "int",
        "default": 25,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_mean_sample_rd": {
        "label": "Maximum mean sample read depth to consider in XHMM.",
        "type": "int",
        "default": 200,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_sd_sample_rd": {
        "label": "Maximum standard deviation of sample read depth to consider in XHMM.",
        "type": "int",
        "default": 150,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_sd_target_rd": {
        "label": "Maximum standard deviation of target read depth to consider in XHMM.",
        "type": "int",
        "default": 30,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_discover_some_qual_threshold": {
        "label": "Quality threshold to consider a variant in XHMM discover mode.",
        "type": "int",
        "default": 30,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_params_values": {
        "label": "List of XHMM parameters values in order: [PVE_mean_factor, PVE_sd_factor, max_target_size, min_target_size, max_mean_target_rd, min_mean_target_rd, max_mean_sample_rd, min_mean_sample_rd, max_sd_sample_rd, max_sd_target_rd]",
        "type": "list",
        "default": [1e-8, 6, 70, -3, 1, 0, 1, 3, 1],
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "use_cohort_data": {
        "label": "Load coverage data from previous experiments for normal estimation. Need file: cohort_data/cohort_cnv_info.tar.gz",
        "type": "bool",
        "default": false
      },
      "create_cohort_data": {
        "label": "Save info about coverage data to the cohort_cnv_info file. (include loaded cohort data)",
        "type": "bool",
        "default": true
      },
      "calling_type": {
        "constant": "germline"
      }
    },
    "samples": {
      "sample_type": {
        "label": "Sample type (role)",
        "type": "enum",
        "default": "sample",
        "list": {
          "sample": "Sample (study subject)",
          "control": "Control (reference panel)"
        }
      }
    }
  }
}

