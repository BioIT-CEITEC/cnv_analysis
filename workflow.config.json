{
  "workflow_description": {
    "name": "germ_cnv_sv_calling",
    "version": 1.0,
    "label": "Germline CNV and structural variant calling",
    "type": "var_call",
    "management_system": "nextflow",
    "entry_point": false,
    "run_parameters": {
      "cpu": 31,
      "memory": 65
    },
    "inputs": [
      "mapped/{sample}.bam*"
    ],
    "outputs": [
      "structural_varcalls/*"
    ],
    "inputs_optional": [
      "cohort_data/cohort_cnv_info.tar.gz"
    ],
    "outputs_optional": [
      "cohort_data/cohort_cnv_info.tar.gz"
    ]
  },
  "general_params": [
    "entity_name",
    "sample_name"
  ],
  "requested_params": [
    "organism",
    "assembly",
    "release",
    "lib_ROI"
  ],
  "gui_params": {
    "primary": {
      "min_number_callers": {
        "label": "Minimum number of callers to consider a variant.",
        "type": "int",
        "default": 2
      },
      "size_threshold": {
        "label": "Filter CNVs bigger than this threshold.",
        "type": "int",
        "default": 500000
      },
      "smooth_gap_bp": {
        "label": "Merge CNVs closer than this distance.",
        "type": "int",
        "default": 10000
      },
    "use_cnmops": {
        "label": "Use cnMOPS for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_cnvkit": {
        "label": "Use CNVkit for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_conifer": {
        "label": "Use conifer for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_controlfreec": {
        "label": "Use Control-FREEC for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_ecole": {
        "label": "Use ECOLE for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_exomedepth": {
        "label": "Use ExomeDepth for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_gatk": {
        "label": "Use GATK_cnv for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_jabcontool": {
        "label": "Use jabCoNtool for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_panelcnmops": {
        "label": "Use panel cnMOPS for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_xhmm": {
        "label": "Use XHMM for variant calling.",
        "type": "bool",
        "default": true
      },
      "run_pseudogene": {
        "label": "Run pseudogene reads reanalysis.",
        "type": "bool",
        "default": false
       }
    },
    "detailed": {
      "wgs_bin_size": {
        "label": "Bin size to split genome to in WGS",
        "type": "int",
        "default": 50000
      },
      "use_panelcnmops_cohortdata": {
        "label": "Use cohort data for panel cnMOPS.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_panelcnmops": true
            }
          }
        }
      },
      "use_cnmops_cohortdata": {
        "label": "Use cohort data for cnMOPS.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_cnmops": true
            }
          }
        }
      },
      "use_exomedepth_cohortdata": {
        "label": "Use cohort data for ExomeDepth.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_exomedepth": true
            }
          }
        }
      },
      "conifer_min_rpkm": {
        "label": "Minimum RPKM for conifer.",
        "type": "int",
        "default": 1,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_conifer": true
            }
          }
        }
      },
      "conifer_svd_components": {
        "label": "Number of SVD components to use in conifer.",
        "type": "int",
        "default": 12,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_conifer": true
            }
          }
        }
      },
      "conifer_threshold": {
        "label": "threshold to consider a variant in conifer.",
        "type": "string",
        "default": 3,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_conifer": true
            }
          }
        }
      },
      "jabCoNtool_use_snps": {
        "label": "Use snps allelic frequency.",
        "type": "bool",
        "default": true,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_predict_TL": {
        "label": "Predict tumor DNA fraction in somatic samples.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_normalize_to_GC": {
        "label": "Normalize read count to GC content for WGS.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "jabCoNtool_remove_centromeres": {
        "label": "Remove centromere regions in WGS.",
        "type": "bool",
        "default": false,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_jabcontool": true
            }
          }
        }
      },
      "xhmm_min_target_size": {
        "label": "Minimum target size to consider in XHMM.",
        "type": "int",
        "default": 10,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_target_size": {
        "label": "Maximum target size to consider in XHMM.",
        "type": "int",
        "default": 10000,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_min_mean_target_rd": {
        "label": "Minimum mean target read depth to consider in XHMM.",
        "type": "int",
        "default": 10,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_mean_target_rd": {
        "label": "Maximum mean target read depth to consider in XHMM.",
        "type": "int",
        "default": 500,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_min_mean_sample_rd": {
        "label": "Minimum mean sample read depth to consider in XHMM.",
        "type": "int",
        "default": 25,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_mean_sample_rd": {
        "label": "Maximum mean sample read depth to consider in XHMM.",
        "type": "int",
        "default": 200,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_sd_sample_rd": {
        "label": "Maximum standard deviation of sample read depth to consider in XHMM.",
        "type": "int",
        "default": 150,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_max_sd_target_rd": {
        "label": "Maximum standard deviation of target read depth to consider in XHMM.",
        "type": "int",
        "default": 30,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_discover_some_qual_threshold": {
        "label": "Quality threshold to consider a variant in XHMM discover mode.",
        "type": "int",
        "default": 30,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_params_values": {
        "label": "List of XHMM parameters values",
        "type": "string",
        "default": "[1e-4, 3, 6, -3, 1, 0, 1, 3, 1]",
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "xhmm_pve_mean_factor": {
        "label": "Factor to multiply the mean PVE to determine the number of PCA components to use in XHMM.",
        "type": "string",
        "default": 0.7,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_xhmm": true
            }
          }
        }
      },
      "freec_breakpoint_threshold": {
        "label": "Breakpoint threshold for Control-FREEC.",
        "type": "string",
        "default": 0.6,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_mappability_k": {
        "label": "K-mer size for mappability calculation in Control-FREEC.",
        "type": "int",
        "default": 30,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_mappability_e": {
        "label": "Mappability threshold for Control-FREEC.",
        "type": "int",
        "default": 2,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_ploidy": {
        "label": "Ploidy for Control-FREEC.",
        "type": "int",
        "default": 2,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_window": {
        "label": "Window size for Control-FREEC.",
        "type": "int",
        "default": 0,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_min_expected_gc": {
        "label": "Minimum expected GC content for Control-FREEC.",
        "type": "string",
        "default": 0.4,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_max_expected_gc": {
        "label": "Maximum expected GC content for Control-FREEC.",
        "type": "string",
        "default": 0.5,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_coeff_var": {
        "label": "Coefficient of variation for Control-FREEC.",
        "type": "string",
        "default": 0.1,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "freec_min_map": {
        "label": "Minimum mappability for Control-FREEC.",
        "type": "string",
        "default": 0.85,
        "conditions": {
          "relevance": {
            "operand": "equal",
            "negation": false,
            "values": {
              "use_controlfreec": true
            }
          }
        }
      },
      "purple_diploid_regions": {
        "label": "Use purple diploid regions for variant calling.",
        "type": "bool",
        "default": true
      },
      "use_cohort_data": {
        "label": "Load coverage data from previous experiments for normal estimation. Need file: cohort_data/cohort_cnv_info.tar.gz",
        "type": "bool",
        "default": false
      },
      "calling_type": {
        "type": "constant",
        "default": "germline"
      },
      "create_cohort_data": {
        "label": "Save info about coverage data to the cohort_cnv_info file. (include loaded cohort data)",
        "type": "bool",
        "default": true
      }
    }
  }
}