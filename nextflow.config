params {

    organism        = 'homo_sapiens'
    assembly        = 'GRCh38'
    release         = 'r111'
    lib_ROI         = 'HyperExomeV2_GRCh38_GRCh38'

    // Genome sequence
    organism_fasta          = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.fa'
    organism_dict           = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.dict'
    organism_chr_sizes      = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.chrom.sizes'
    organism_ploidy_priors  = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.ploidy_priors.tsv'
    organism_excluded_sites = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.excl'
    organism_ucsc           = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.fa.fai.ucsc'
    organism_delly_map      = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38_map.fa'
    organism_snp_bed        = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.snp.bed'

    // Annotation (release r111)
    organism_gtf        = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/annot/r111/GRCh38.gtf'
    organism_gtf_tsv    = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/annot/r111/GRCh38.tsv'
    organism_vep_dir    = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/annot/r111/vep'

    // PURPLE / copy-number tools
    organism_hetsites            = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/tool_data/PURPLE/GRCh38.tsv.gz'
    organism_germline_hotspots   = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/tool_data/PURPLE/GRCh38_germ_hotspots.vcf.gz'
    organism_germline_dels       = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/tool_data/PURPLE/GRCh38_germline_del.csv'
    organism_germline_driverpanel= '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/tool_data/PURPLE/GRCh38_driver_panel.tsv'
    organism_gc_profile          = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/tool_data/PURPLE/GRCh38_GC_profile.cnp'
    organism_diploid_regions     = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/tool_data/PURPLE/GRCh38_diploid_regions.bed.gz'

    // Other databases
    organism_cytoband   = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/cytoband/GRCh38.cytoband.tsv'
    organism_svdb       = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/svdb/gnomad_v2.1_sv.sites.vcf'
    organism_dbsnp      = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/dbSNP/common_all.vcf.gz'

    // Panel-specific (panel = HyperExomeV2_GRCh38)
    organism_dna_panel      = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38.bed'
    organism_gene_bed       = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_pair.bed'
    organism_pseudogene_bed = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_pseudogenes.bed'
    organism_snps_panel     = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/snp/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_snps.tsv'
    organism_interval_list  = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38.interval_list'

    // Pre-built cohort RData files (used only when use_*_cohortdata = true)
    cohort_panelcnmops_ref  = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_panelcnmops.RData'
    cohort_cnmops_ref       = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_cnmops.RData'
    cohort_exomedepth_ref   = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_exomedepth.RData'

// ─── Caller toggles ──────────────────────────────────────────────────────────

    use_cnmops       = true
    use_cnvkit       = true
    use_conifer      = true
    use_controlfreec = true
    use_ecole        = true
    use_exomedepth   = true
    use_gatk         = true
    use_jabcontool   = true
    use_panelcnmops  = true
    use_xhmm         = true

    use_panelcnmops_cohortdata = false
    use_cnmops_cohortdata      = false
    use_exomedepth_cohortdata  = false
    use_cohort_data            = false
    create_cohort_data         = true

// ─── General run settings ────────────────────────────────────────────────────

    calling_type               = 'germline'
    tumor_normal               = false
    run_pseudogene             = false
    min_number_callers         = 2
    AF_threshold               = 0.5
    wgs_bin_size               = 50000
    purple_diploid_regions     = true
    freec_breakpoint_threshold = 0.6

// ─── CoNIFER ─────────────────────────────────────────────────────────────────

    conifer_min_rpkm       = 5
    conifer_svd_components = 6
    conifer_threshold      = 0.6

// ─── XHMM ────────────────────────────────────────────────────────────────────

    xhmm_min_target_size              = 150
    xhmm_max_target_size              = 10000
    xhmm_pve_mean_factor              = 0.7
    xhmm_min_mean_target_rd           = 100
    xhmm_max_mean_target_rd           = 500
    xhmm_min_mean_sample_rd           = 25
    xhmm_max_mean_sample_rd           = 200
    xhmm_max_sd_sample_rd             = 300
    xhmm_max_sd_target_rd             = 30
    xhmm_discover_some_qual_threshold = 30
    xhmm_params_values                = '1e-4, 3, 6, -3, 1, 0, 1, 3, 1'

// ─── JABCoNTool ──────────────────────────────────────────────────────────────

    jabCoNtool_use_snps                    = true
    jabCoNtool_predict_TL                  = false
    jabCoNtool_normalize_to_GC             = false
    jabCoNtool_remove_centromeres          = false
    jabCoNtool_max_CNV_occurance_in_cohort = 20

// ─── Control-FREEC ───────────────────

    freec_mappability_k   = 30
    freec_mappability_e   = 2
    freec_ploidy          = 2
    freec_window          = 0
    freec_min_expected_gc = 0.4
    freec_max_expected_gc = 0.5
    freec_coeff_var       = 0.1
    freec_min_map         = 0.85

// ─── Samples ─────────────────────────────────────────────────────────────────
// sample_name must match the BAM file prefix under <projectDir>/mapped/

    samples = [
        DT2001krev: [sample_name: 'DT2001krev'],
        JK2104krev: [sample_name: 'JK2104krev'],
        KC1509krev: [sample_name: 'KC1509krev'],
        KP1956krev: [sample_name: 'KP1956krev'],
        MH2501krev: [sample_name: 'MH2501krev'],
        MK1062krev: [sample_name: 'MK1062krev'],
        OB0809krev: [sample_name: 'OB0809krev'],
        VZ2558krev: [sample_name: 'VZ2558krev'],
    ]
}

// ─── Conda ───────────────────────────────────────────────────────────────────

conda {
    enabled       = true
    createTimeout = '2 h'
}

// ─── Executor ────────────────────────────────────────────────────────────────

executor {
    cpus      = 30
    memory    = '90 GB'
    queueSize = 8
}

// ─── Per-process resource limits ─────────────────────────────────────────────

process {

    withName: 'JABCONTOOL_CALL' {
        maxForks = 1
        memory   = '8 GB'
    }
    withName: 'SNP_AF_CALC' {
        maxForks = 8
        memory   = '4 GB'
    }
    withName: 'COVERAGE_CALC' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'COHORT_GENERATION_GATK' {
        memory = '10 GB'
    }
    withName: 'GERMLINE_PLOIDY_DETERMINATION_GATK' {
        memory = '12 GB'
    }
    withName: 'CNV_CALL_CNMOPS' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'CNV_CALL_PANELCNMOPS' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'CNV_CALL_EXOMEDEPTH' {
        maxForks = 4
        memory   = '8 GB'
    }
    withName: 'CNV_VARCALLS_GATK' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'PREPARE_COHORT_CNMOPS' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'PREPARE_COHORT_PANELCNMOPS' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'PREPARE_COHORT_EXOMEDEPTH' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'GENMAP_MAP_FREEC' {
        cpus     = 8
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'GENMAP_INDEX_FREEC' {
        maxForks = 1
        memory   = '90 GB'
    }
}
