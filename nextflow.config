params {

    assembly        = 'hg19'
    lib_ROI         = 'CZE-30_cnvkit_v3' // This is the name of the panel-specific region list that will be used in the analysis. It must match the name of the panel-specific region list file.

    // Genome sequence
    organism_fasta         = '/mnt/xraid/CNV_CEITEC/data/reference/HG19uscs.fa'
    organism_dict          = '/mnt/xraid/CNV_CEITEC/data/reference/HG19uscs.dict'
    organism_ploidy_priors = '/mnt/xraid/CNV_CEITEC/data/reference/HG19.ploidy_priors.tsv' // This file contains the expected number of copies per cromosome for the specific reference

    // Annotation
    organism_gtf     = '/mnt/xraid/CNV_CEITEC/data/reference/hg19.refGene.gtf'
    organism_gtf_tsv = '/mnt/xraid/CNV_CEITEC/data/reference/hg19.tsv' // Some of the tools require a tabular version of the gtf rather than the actual gtf

    // Other databases
    organism_cytoband = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/cytoband/GRCh38.cytoband.tsv' // not required for this test

    // Panel-specific (panel = HyperExomeV2_GRCh38)
    organism_dna_panel  = '/mnt/xraid/CNV_CEITEC/BED_DIR/CZE-30_cnvkit_v3.merged.bed'
    organism_snps_panel = '/mnt/xraid/CNV_CEITEC/BED_DIR/CZE-30_cnvkit_v3_snps.merged.tsv' // This is a file with the known SNPs within the regionos of interest

    // Pre-built cohort RData files (used only when use_*_cohortdata = true)
    cohort_panelcnmops_ref  = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_panelcnmops.RData' // not necessary as the cohort will be generated
    cohort_cnmops_ref       = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_cnmops.RData' // not necessary as the cohort will be generated
    cohort_exomedepth_ref   = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/HyperExomeV2_GRCh38/HyperExomeV2_GRCh38_exomedepth.RData' // not necessary as the cohort will be generated

// ─── Caller toggles ──────────────────────────────────────────────────────────

    use_cnmops       = true
    use_cnvkit       = true
    use_conifer      = true
    use_controlfreec = true
    use_ecole        = true // This tool requires a lot of time to run for WGS data in our tests so it is fine if you set it to false if you want
    use_exomedepth   = true
    use_gatk         = true
    use_jabcontool   = true
    use_panelcnmops  = true
    use_xhmm         = true

    use_panelcnmops_cohortdata = false
    use_cnmops_cohortdata      = false
    use_exomedepth_cohortdata  = false
    use_cohort_data            = false

// ─── General run settings ────────────────────────────────────────────────────

    wgs_bin_size               = 50000
    freec_breakpoint_threshold = 0.6

// ─── Gene ────────────────────────────────────────────────────

    gene_pseudogene_bed = 'gene_pseudogene.bed' // This is a file with the regions of the genome that are known to be problematic for CNV calling. It is used to filter out CNV calls that overlap with these regions.
    run_pseudogene = false

// ─── Consensus model ─────────────────────────────────────────────────────────
// use_consensus = true replaces merging_and_smoothing.R with the trained
// consensus model (modules/consensus_model) for combining the caller outputs.

    use_consensus    = false
    consensus_cutoff = null   // consensus score threshold; null = keep every scored candidate
    consensus_model  = null   // path to a .pkl model; null = the one shipped in modules/consensus_model/

    // Training. Set consensus_train = true to fit a new model from ground-truth
    // data; the resulting model is published to consensus_model/ and, when
    // use_consensus = true, is the one used to score this run.
    consensus_train            = false
    consensus_train_gt_dir     = null   // REQUIRED when training: directory of <SAMPLE>_selected_regions.tsv files
                                        // columns: sample, chrom, start, end, name, variant_type, type (DEL/DUP)
    consensus_train_sv_dir     = null   // optional: directory with one sub-directory of caller calls per training
                                        // sample (e.g. structural_varcalls_simulated_BR). When null, the caller
                                        // calls produced by this run are used as the training cohort.
    consensus_train_callers    = null   // space-separated subset, e.g. 'exomeDepth panelcnMOPS XHMM conifer gatk'
                                        // null = the model's DEFAULT_CALLERS that are present in the data
    consensus_train_weight_cap = 1.0    // upper bound of each (non-negative) caller weight
    consensus_train_cap_mode   = 'per_caller' // 'per_caller' (hit+score <= cap) or 'per_coef' (each coef <= cap)
    consensus_train_l2         = 0.01   // L2 penalty on the coefficients
    consensus_train_test_size  = 0.2    // fraction of samples held out from training
    consensus_train_seed       = 42

// ─── CoNIFER ─────────────────────────────────────────────────────────────────

    conifer_min_rpkm       = 5
    conifer_svd_components = 12
    conifer_threshold      = 0.4

// ─── XHMM ────────────────────────────────────────────────────────────────────

    xhmm_min_target_size              = 150
    xhmm_max_target_size              = 10000
    xhmm_pve_mean_factor              = 0.7
    xhmm_min_mean_target_rd           = 100
    xhmm_max_mean_target_rd           = 500
    xhmm_min_mean_sample_rd           = 25
    xhmm_max_mean_sample_rd           = 200
    xhmm_max_sd_sample_rd             = 300
    xhmm_max_sd_target_rd             = 30
    xhmm_discover_some_qual_threshold = 30
    xhmm_params_values                = '1e-4, 3, 6, -3, 1, 0, 1, 3, 1'

// ─── JABCoNTool ──────────────────────────────────────────────────────────────

    jabCoNtool_use_snps                    = true
    jabCoNtool_predict_TL                  = false
    jabCoNtool_normalize_to_GC             = false
    jabCoNtool_remove_centromeres          = false
    jabCoNtool_max_CNV_occurance_in_cohort = 20

// ─── Control-FREEC ───────────────────────────────────────────────────────────

    freec_mappability_k   = 30
    freec_mappability_e   = 2
    freec_ploidy          = 2
    freec_window          = 0
    freec_min_expected_gc = 0.4
    freec_max_expected_gc = 0.5
    freec_coeff_var       = 0.1
    freec_min_map         = 0.85

// ─── Samples ─────────────────────────────────────────────────────────────────
// sample_name must match the BAM file prefix under <projectDir>/mapped/

    samples = [ //        DT2001krev: [sample_name: 'DT2001krev'],
	'007_CZE3xBRCA1328_run137': [sample_name: '007_CZE3xBRCA1328_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA1388_run137': [sample_name: '007_CZE3xBRCA1388_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA1507op_run137': [sample_name: '007_CZE3xBRCA1507op_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA2678_run137': [sample_name: '007_CZE3xBRCA2678_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA3011_run137': [sample_name: '007_CZE3xBRCA3011_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA3052_run137': [sample_name: '007_CZE3xBRCA3052_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA3297_run137': [sample_name: '007_CZE3xBRCA3297_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA3804_run137': [sample_name: '007_CZE3xBRCA3804_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA3927_run137': [sample_name: '007_CZE3xBRCA3927_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA5995_run137': [sample_name: '007_CZE3xBRCA5995_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA6012_run137': [sample_name: '007_CZE3xBRCA6012_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA6101_run137': [sample_name: '007_CZE3xBRCA6101_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA6260_run137': [sample_name: '007_CZE3xBRCA6260_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA6559_run137': [sample_name: '007_CZE3xBRCA6559_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA7562_run137': [sample_name: '007_CZE3xBRCA7562_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA7747_run137': [sample_name: '007_CZE3xBRCA7747_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA7876_run137': [sample_name: '007_CZE3xBRCA7876_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA7914_run137': [sample_name: '007_CZE3xBRCA7914_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA7990_run137': [sample_name: '007_CZE3xBRCA7990_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8006_run137': [sample_name: '007_CZE3xBRCA8006_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8010_run137': [sample_name: '007_CZE3xBRCA8010_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8013_run137': [sample_name: '007_CZE3xBRCA8013_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8015_run137': [sample_name: '007_CZE3xBRCA8015_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8020_run137': [sample_name: '007_CZE3xBRCA8020_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8021_run137': [sample_name: '007_CZE3xBRCA8021_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8022_run137': [sample_name: '007_CZE3xBRCA8022_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8026_run137': [sample_name: '007_CZE3xBRCA8026_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8029_run137': [sample_name: '007_CZE3xBRCA8029_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA8031_run137': [sample_name: '007_CZE3xBRCA8031_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xBRCA874_run137': [sample_name: '007_CZE3xBRCA874_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xCoriell-NA24143_run137': [sample_name: '007_CZE3xCoriell-NA24143_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xCoriell-NA24385_run137': [sample_name: '007_CZE3xCoriell-NA24385_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xCoriell-NA24631_run137': [sample_name: '007_CZE3xCoriell-NA24631_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xCoriell-NA24694_run137': [sample_name: '007_CZE3xCoriell-NA24694_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xCoriell-NA24695_run137': [sample_name: '007_CZE3xCoriell-NA24695_run137.picard.sorted.RG.rmdup'],
	'007_CZE3xPKM964_run137': [sample_name: '007_CZE3xPKM964_run137.picard.sorted.RG.rmdup']
    ]
}

// ─── Conda ───────────────────────────────────────────────────────────────────

conda {
    enabled       = true
    createTimeout = '2 h'
}

env {
    TMPDIR        = '/mnt/xraid/CNV_CEITEC/cnv_analysis/tmp'
    TMP           = '/mnt/xraid/CNV_CEITEC/cnv_analysis/tmp'
    TEMP          = '/mnt/xraid/CNV_CEITEC/cnv_analysis/tmp'
    _JAVA_OPTIONS = '-Djava.io.tmpdir=/mnt/xraid/CNV_CEITEC/cnv_analysis/tmp'
}
// ─── Executor ────────────────────────────────────────────────────────────────

executor {
    cpus      = 25
    memory    = '90 GB' // We ran it for 100 GB available memory and it work fine, but we set it to 90 GB to be on the safe side and avoid OOM errors.
    queueSize = 2 // This is the maximum number of processes that can run in parallel. Setting it to 8 allows us to run all the processes that have maxForks = 4 in parallel, while still leaving some room for the processes that have maxForks = 1 to run in parallel as well.
}

// ─── Per-process resource limits ─────────────────────────────────────────────

process {
    scratch = false
    beforeScript = 'export PATH=$CONDA_PREFIX/bin:$PATH'
//    withName: '.*XHMM.*' {
//	errorStrategy = 'ignore'
//    }
    withName: 'JABCONTOOL_CALL' {
        maxForks = 1
        memory   = '8 GB'
    }
    withName: 'SNP_AF_CALC' {
        maxForks = 8
        memory   = '4 GB'
    }
    withName: 'COVERAGE_CALC' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'COHORT_GENERATION_GATK' {
        memory = '10 GB'
    }
    withName: 'GERMLINE_PLOIDY_DETERMINATION_GATK' {
        memory = '12 GB'
    }
    withName: 'CNV_CALL_CNMOPS' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'CNV_CALL_PANELCNMOPS' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'CNV_CALL_EXOMEDEPTH' {
        maxForks = 4
        memory   = '8 GB'
    }
    withName: 'CNV_VARCALLS_GATK' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'PREPARE_COHORT_CNMOPS' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'PREPARE_COHORT_PANELCNMOPS' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'PREPARE_COHORT_EXOMEDEPTH' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'GENMAP_MAP_FREEC' {
        cpus     = 8
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'GENMAP_INDEX_FREEC' {
        maxForks = 1
        memory   = '90 GB'
    }
}

