params {

    assembly        = 'GRCh38'
    lib_ROI         = 'BRONCO' // This is the name of the panel-specific region list that will be used in the analysis. It must match the name of the panel-specific region list file.

    // Genome sequence
    organism_fasta         = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.fa'
    organism_dict          = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.dict'
    organism_ploidy_priors = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/seq/GRCh38.ploidy_priors.tsv' // This file contains the expected number of copies per cromosome for the specific reference

    // Annotation
    organism_gtf     = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/annot/r111/GRCh38.gtf'
    organism_gtf_tsv = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/annot/r111/GRCh38.tsv' // Some of the tools require a tabular version of the gtf rather than the actual gtf

    // Other databases
    organism_cytoband = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/cytoband/GRCh38.cytoband.tsv' // not required for this test

    // Panel-specific (panel = BRONCO)
    organism_dna_panel  = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/BRONCO/BRONCO.bed'
    organism_snps_panel = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/snp/BRONCO/BRONCO_snps.tsv' // This is a file with the known SNPs within the regionos of interest

    // Pre-built cohort RData files (used only when use_*_cohortdata = true)
    cohort_panelcnmops_ref  = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/BRONCO/BRONCO_GRCh38_panelcnmops.RData' // not necessary as the cohort will be generated
    cohort_cnmops_ref       = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/BRONCO/BRONCO_GRCh38_cnmops.RData' // not necessary as the cohort will be generated
    cohort_exomedepth_ref   = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/resources/references/homo_sapiens/GRCh38/others/DNA_ROI/BRONCO/BRONCO_GRCh38_exomedepth.RData' // not necessary as the cohort will be generated

// ─── Caller toggles ──────────────────────────────────────────────────────────

    use_cnmops       = true
    use_cnvkit       = true
    use_conifer      = true
    use_controlfreec = true
    use_ecole        = false // This tool requires a lot of time to run for WGS data in our tests so it is fine if you set it to false if you want
    use_exomedepth   = true
    use_gatk         = true
    use_jabcontool   = true
    use_panelcnmops  = true
    use_xhmm         = true

    use_panelcnmops_cohortdata = false
    use_cnmops_cohortdata      = false
    use_exomedepth_cohortdata  = false
    use_cohort_data            = false

// ─── General run settings ────────────────────────────────────────────────────

    wgs_bin_size               = 50000
    freec_breakpoint_threshold = 0.6
    min_number_callers = 3
    size_threshold = 500000
    smooth_gap_bp = 10000

// ─── Gene ────────────────────────────────────────────────────

    gene_pseudogene_bed = 'gene_pseudogene.bed' // This is a file with the regions of the genome that are known to be problematic for CNV calling. It is used to filter out CNV calls that overlap with these regions.
    run_pseudogene = false

// ─── Consensus model ─────────────────────────────────────────────────────────
// use_consensus = true replaces merging_and_smoothing.R (MERGE_VARIANT_CALLS)
// with the tuned XGBoost consensus model in modules/xgboost_consensus_model.
// OOF row precision 0.884 / recall 0.928 unthresholded
// (modelling/reports/metrics/no_freec_cnmops.md, inside the module).
//
// "freec/cnMOPS dropped" means dropped as DIRECT features only. Both callers
// still feed the model: they are counted in agreement_count and they take part
// in candidate merging (so they affect which candidates exist, their
// boundaries -> log_span_width, and type_conflict). Training built its rows the
// same way, so this is required for train/serve parity — do not remove them
// from the scorer. Genuinely dropping them means retraining from a 6-caller
// candidate table. Corollary: ALL 8 callers must stay enabled below, otherwise
// agreement_count silently shifts off-distribution and xgb_cutoff no longer
// means what the report says it means.
//
// NOTE: min_number_callers and size_threshold apply ONLY to the rule-based
// path; they are inert when use_consensus = true. xgb_cutoff is the filter.
//
// The model is trained OFFLINE by the module's modelling/src/train_no_freec_cnmops.py; the
// pipeline only scores. Both paths emit the same output files, so
// CLASSIFY_AND_ANNOTATE and FINAL_FORMATTING_TABLES are unaffected either way.

    use_consensus = true
    xgb_model     = null   // path to an XGBoost native-format .json; null = the one
                           // shipped in modules/xgboost_consensus_model/
    xgb_cutoff    = 0.7499 // score threshold for the annotated/final tables.
                           // 0.7499 is the model's own >=0.90-precision operating
                           // point: precision 0.9002 / recall 0.9191
                           // (modelling/reports/metrics/no_freec_cnmops.md).
                           // Set to null to keep every scored candidate; the
                           // complete scored table is written to
                           // *_all_scored_candidates.tsv either way.

// ─── CoNIFER ─────────────────────────────────────────────────────────────────

    conifer_min_rpkm       = 5
    conifer_svd_components = 3
    conifer_threshold      = 0.4

// ─── XHMM ────────────────────────────────────────────────────────────────────

    xhmm_min_target_size              = 150
    xhmm_max_target_size              = 10000
    xhmm_pve_mean_factor              = 0.7
    xhmm_min_mean_target_rd           = 100
    xhmm_max_mean_target_rd           = 500
    xhmm_min_mean_sample_rd           = 25
    xhmm_max_mean_sample_rd           = 200
    xhmm_max_sd_sample_rd             = 300
    xhmm_max_sd_target_rd             = 30
    xhmm_discover_some_qual_threshold = 30
    xhmm_params_values                = '1e-4, 3, 6, -3, 1, 0, 1, 3, 1'

// ─── JABCoNTool ──────────────────────────────────────────────────────────────

    jabCoNtool_use_snps                    = true
    jabCoNtool_predict_TL                  = false
    jabCoNtool_normalize_to_GC             = false
    jabCoNtool_remove_centromeres          = false
    jabCoNtool_max_CNV_occurance_in_cohort = 20

// ─── Control-FREEC ───────────────────────────────────────────────────────────

    freec_mappability_k   = 30
    freec_mappability_e   = 2
    freec_ploidy          = 2
    freec_window          = 0
    freec_min_expected_gc = 0.4
    freec_max_expected_gc = 0.5
    freec_coeff_var       = 0.1
    freec_min_map         = 0.85

// ─── Samples ─────────────────────────────────────────────────────────────────
// sample_name must match the BAM file prefix under <projectDir>/mapped/

    samples = [
        'BR-2117_15min':  [sample_name: 'BR-2117_15min'],
        'BR-2126':        [sample_name: 'BR-2126'],
        'BR-2127':        [sample_name: 'BR-2127'],
        'BR-2128':        [sample_name: 'BR-2128'],
        'BR-2129':        [sample_name: 'BR-2129'],
        'BR-2131':        [sample_name: 'BR-2131'],
        'BR-2132':        [sample_name: 'BR-2132'],
        'BR-2133':        [sample_name: 'BR-2133'],
        'BR-2134':        [sample_name: 'BR-2134'],
        'BR-2135':        [sample_name: 'BR-2135'],
        'BR-2136':        [sample_name: 'BR-2136'],
        'BR-2137':        [sample_name: 'BR-2137'],
        'BR-2138':        [sample_name: 'BR-2138'],
        'H-0941_15min':   [sample_name: 'H-0941_15min'],
        'H-0948':         [sample_name: 'H-0948'],
        'H-0949':         [sample_name: 'H-0949'],
        'H-0950':         [sample_name: 'H-0950'],
        'H-0951':         [sample_name: 'H-0951'],
        'H-0952':         [sample_name: 'H-0952'],
        'H-0953':         [sample_name: 'H-0953'],
        'H-0954':         [sample_name: 'H-0954'],
        'H-0955':         [sample_name: 'H-0955'],
        'H-0956':         [sample_name: 'H-0956']
    ]
}

// ─── Conda ───────────────────────────────────────────────────────────────────

conda {
    enabled       = true
    createTimeout = '2 h'
}

env {
    TMPDIR        = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/base/workspace/aman/cnv/tmp'
    TMP           = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/base/workspace/aman/cnv/tmp'
    TEMP          = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/base/workspace/aman/cnv/tmp'
    _JAVA_OPTIONS = '-Djava.io.tmpdir=/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/base/workspace/aman/cnv/tmp'
}

process {
    scratch = '/mnt/data/ceitec_cfg2/710000-CEITEC/713000-cmm/713016-bioit/base/workspace/aman/cnv/tmp'
}
// ─── Executor ────────────────────────────────────────────────────────────────

executor {
    cpus      = 25
    memory    = '90 GB' // We ran it for 100 GB available memory and it work fine, but we set it to 90 GB to be on the safe side and avoid OOM errors.
    queueSize = 2 // This is the maximum number of processes that can run in parallel. Setting it to 8 allows us to run all the processes that have maxForks = 4 in parallel, while still leaving some room for the processes that have maxForks = 1 to run in parallel as well.
}

// ─── Per-process resource limits ─────────────────────────────────────────────

process {
    scratch = false
    beforeScript = 'export PATH=$CONDA_PREFIX/bin:$PATH'
//    withName: '.*XHMM.*' {
//	errorStrategy = 'ignore'
//    }
    withName: 'JABCONTOOL_CALL' {
        maxForks = 1
        memory   = '8 GB'
    }
    withName: 'SNP_AF_CALC' {
        maxForks = 8
        memory   = '4 GB'
    }
    withName: 'COVERAGE_CALC' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'COHORT_GENERATION_GATK' {
        memory = '10 GB'
    }
    withName: 'GERMLINE_PLOIDY_DETERMINATION_GATK' {
        memory = '12 GB'
    }
    withName: 'CNV_CALL_CNMOPS' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'CNV_CALL_PANELCNMOPS' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'CNV_CALL_EXOMEDEPTH' {
        maxForks = 4
        memory   = '8 GB'
    }
    withName: 'CNV_VARCALLS_GATK' {
        maxForks = 4
        memory   = '10 GB'
    }
    withName: 'PREPARE_COHORT_CNMOPS' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'PREPARE_COHORT_PANELCNMOPS' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'PREPARE_COHORT_EXOMEDEPTH' {
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'GENMAP_MAP_FREEC' {
        cpus     = 8
        maxForks = 1
        memory   = '90 GB'
    }
    withName: 'GENMAP_INDEX_FREEC' {
        maxForks = 1
        memory   = '90 GB'
    }
}
